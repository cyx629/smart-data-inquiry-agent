# 复制为 .env 后填写。LLM 走 OpenAI 兼容接口,云端 API 与 vLLM 私有化可切换。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
# 总结/改写用小模型降本(可选,不配则复用主模型)
# LLM_LIGHT_MODEL=deepseek-chat

# Embedding 服务(可选,OpenAI 兼容 /embeddings,如 bge-m3;
# 不配置时检索退化为词面重叠打分,表少的库不受影响)
# EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
# EMBEDDING_API_KEY=EMPTY
# EMBEDDING_MODEL=bge-m3

# 安全与执行(可选)
# MAX_ROWS=100
# MAX_RETRIES=3
